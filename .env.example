# =====================================================================================================
# Workings — environment variables
#
# The site builds, deploys and works with EVERY variable below left empty. Nothing is required except
# that you should set NEXT_PUBLIC_SITE_URL before launch so canonical URLs, Open Graph tags and the
# sitemap use your real https domain.
#
# Rules:
#   * Variables whose name starts with NEXT_PUBLIC_ are embedded in the browser bundle. They must NEVER be secrets.
#   * Everything else is read on the server at BUILD time. Changing a value means redeploying.
#   * No variable here is a secret. There is deliberately no database, no auth and no API key in this project.
#   * Copy this file to .env.local for local development. Never commit .env.local (it is git-ignored).
# =====================================================================================================

# ---------- REQUIRED FOR LAUNCH (not for building) ---------------------------------------------------
# Your canonical origin, https, no trailing slash. On Vercel you can leave this empty and the production
# domain from VERCEL_PROJECT_PRODUCTION_URL is used, but setting it explicitly is safer.
NEXT_PUBLIC_SITE_URL=

# ---------- OPTIONAL: site identity (shown on Contact, Privacy, About and Advertise pages) ------------
# Public contact address. If empty, the Contact page says no address has been published yet.
CONTACT_EMAIL=
# Name of the person or company operating the site (footer, About, Privacy). If empty, the site name is used.
SITE_OPERATOR_NAME=

# ---------- OPTIONAL: analytics (anonymous, privacy-friendly; OFF unless fully configured) ------------
# Master switch. Even when "true" nothing is sent unless a provider below is fully configured.
ANALYTICS_ENABLED=false
# plausible | umami
ANALYTICS_PROVIDER=
# Plausible: your site domain, e.g. example.com
ANALYTICS_DOMAIN=
# Umami: your website id
ANALYTICS_WEBSITE_ID=
# Script URL (https only). Defaults to https://plausible.io/js/script.js for Plausible; required for Umami
# (e.g. https://cloud.umami.is/script.js or your self-hosted URL).
ANALYTICS_SCRIPT_SRC=

# ---------- OPTIONAL: programmatic advertising (Google AdSense) ---------------------------------------
# Master switch for all programmatic ads. Default false.
ADS_ENABLED=false
# AdSense on/off (also requires ADS_ENABLED=true and a valid publisher id).
ADSENSE_ENABLED=false
# Public publisher id, format ca-pub-1234567890123456. (Public by design — it appears in the page source.)
ADSENSE_PUBLISHER_ID=
# One ad-unit id per placement (digits only). A placement without an id simply shows nothing.
ADSENSE_SLOT_TOP=
ADSENSE_SLOT_IN_CONTENT=
ADSENSE_SLOT_RESULT_BELOW=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_FOOTER=

# ---------- OPTIONAL: affiliate marketing -------------------------------------------------------------
# Affiliate links live in src/config/affiliates.ts (empty by default). This switch must also be true.
AFFILIATES_ENABLED=false

# ---------- OPTIONAL: direct sponsorships -------------------------------------------------------------
# Sponsors live in src/config/sponsors.ts (empty by default). This switch must also be true.
DIRECT_ADS_ENABLED=false
